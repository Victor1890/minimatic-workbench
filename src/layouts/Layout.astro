---
import '../styles/global.css';

interface Props {
	title?: string;
}

const { title = "Minimatic Workbench | Docs" } = Astro.props;
---

<!doctype html>
<html lang="en" class="h-full w-full">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700&family=Inter:wght@400;500;600&family=Fira+Code:wght@400;500&display=swap" rel="stylesheet">
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="h-full w-full bg-surface text-on-surface font-body antialiased selection:bg-primary-container selection:text-on-primary-container">
		<slot />
	</body>
</html>
