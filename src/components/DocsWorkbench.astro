---
import { Icon } from 'astro-icon/components';

interface Props {
	initialSlug?: string;
	initialContent?: string;
	initialTitle?: string;
	initialPath?: string;
}

const { initialSlug, initialContent, initialTitle, initialPath } = Astro.props;

// Read src/content/**/*.md files dynamically from deep nested subfolders
const contentFiles = import.meta.glob('../content/**/*.md', { query: '?raw', eager: true, import: 'default' });

function formatName(name: string) {
  return name
    .replace(/\.md$/, '')
    .split(/[-_]/)
    .map(w => w.charAt(0).toUpperCase() + w.slice(1))
    .join(' ');
}

interface FileItem {
  id: string;
  slug: string;
  title: string;
  path: string;
  content: string;
}

interface TreeNode {
  name: string;
  displayName: string;
  type: 'folder' | 'file';
  id?: string;
  slug?: string;
  children?: TreeNode[];
}

const docList: FileItem[] = [];
const treeRoot: TreeNode[] = [];

function getOrCreateFolder(parentChildren: TreeNode[], folderName: string): TreeNode {
  let folder = parentChildren.find(c => c.type === 'folder' && c.name === folderName);
  if (!folder) {
    folder = {
      name: folderName,
      displayName: formatName(folderName),
      type: 'folder',
      children: []
    };
    parentChildren.push(folder);
  }
  return folder;
}

Object.entries(contentFiles).forEach(([filePath, content]) => {
  const relative = filePath.replace(/^.*\/content\//, '');
  const parts = relative.split('/');
  const fileName = parts.pop() || '';
  const docId = relative.replace(/\.md$/, '').replace(/[\/\s]+/g, '-');
  const slug = relative.replace(/\.md$/, '').toLowerCase().replace(/[\/\s]+/g, '/');
  const title = formatName(fileName);

  docList.push({
    id: docId,
    slug,
    title,
    path: relative,
    content: content as string
  });

  let currentLevel = treeRoot;
  parts.forEach(folderName => {
    const folder = getOrCreateFolder(currentLevel, folderName);
    currentLevel = folder.children!;
  });

  currentLevel.push({
    name: fileName,
    displayName: title,
    type: 'file',
    id: docId,
    slug
  });
});

const totalDocsCount = docList.length;
---

<div class="flex flex-col h-screen w-screen overflow-hidden bg-surface">
	<!-- Navbar (Astro Docs Style: withastro/docs) -->
	<header class="h-15 bg-surface border-b border-outline-variant flex items-center justify-between px-5 gap-4">
		<div class="flex items-center gap-2.5 min-w-[200px]">
			<a href="/" class="flex items-center gap-2 no-underline text-on-surface">
				<svg width="24" height="24" viewBox="0 0 24 24" fill="none">
					<path d="M12 2L2 22H6L12 10L18 22H22L12 2Z" fill="#17805e"/>
					<circle cx="12" cy="15" r="2.5" fill="#a8d5c4"/>
				</svg>
				<span class="font-display font-bold text-lg">Minimatic</span>
				<span class="font-medium text-sm text-primary">Docs</span>
			</a>
			<span class="bg-surface-container-high text-on-surface-variant text-[11px] font-semibold px-2 py-0.5 rounded-full border border-outline">v0.1</span>
		</div>

		<!-- Search Input (Astro Docs style) -->
		<div class="relative flex-1 max-w-[420px] flex items-center">
			<svg class="absolute left-3 text-on-surface-variant" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
				<circle cx="11" cy="11" r="8"></circle>
				<line x1="21" y1="21" x2="16.65" y2="16.65"></line>
			</svg>
			<input type="text" id="doc-search-input" placeholder="Search documentation... (Press '/')" class="w-full h-9.5 pl-9 pr-3.5 bg-surface-container-low border border-outline rounded-full text-xs text-on-surface outline-none focus:border-primary focus:ring-2 focus:ring-primary/10 focus:bg-white transition-all" />
		</div>

		<!-- Nav Links -->
		<nav class="flex items-center gap-2">
			<button class="nav-link-btn active bg-primary-container text-primary font-semibold text-xs px-3 py-1.5 rounded-full cursor-pointer hover:bg-primary-container/80 transition-colors" data-filter="all">All</button>
			<a href="https://github.com/gabrielebaez/minimatic-kernel" target="_blank" rel="noopener" class="text-on-surface-variant hover:text-primary p-1.5 rounded-full transition-colors flex items-center" title="GitHub Repository">
				<Icon name="github" class="w-5 h-5" />
			</a>
			<button id="btn-reset" class="bg-transparent text-on-surface border border-outline rounded-full px-3.5 py-1.5 font-semibold text-xs cursor-pointer hover:bg-surface-container-high transition-colors">Reset</button>
			<button id="btn-copy" class="bg-primary text-on-primary border-none rounded-full px-4 py-1.5 font-semibold text-xs cursor-pointer hover:bg-primary-hover shadow-sm transition-colors">Copy MD</button>
		</nav>
	</header>

	<!-- Main Fourfold Workspace -->
	<div class="grid grid-cols-[280px_1fr_1fr] h-[calc(100vh-60px)] overflow-hidden">
		<!-- Sidebar Nav (Astro Docs Recursive Folder Tree) -->
		<aside class="bg-surface-container-low border-r border-outline-variant flex flex-col p-4 overflow-hidden">
			<div class="flex items-center justify-between mb-3 px-2">
				<span class="text-[11px] font-bold tracking-wider text-on-surface-variant">DOCUMENTATION</span>
				<span id="doc-count-badge" class="bg-surface-container-highest text-on-surface text-[10px] font-bold px-1.5 py-0.5 rounded">{totalDocsCount}</span>
			</div>
			
			<nav class="flex-1 overflow-y-auto pr-1">
				<ul class="flex flex-col gap-1.5 list-none m-0 p-0 top-level">
					{treeRoot.map((node) => (
						<li class="list-none group-li">
							{node.type === 'folder' ? (
								<details open class="block group-details">
									<summary class="flex items-center justify-between px-2.5 py-1.5 rounded-md cursor-pointer select-none hover:bg-surface-container-high transition-colors group-summary">
										<span class="group-label">
											<span class="text-xs font-bold text-on-surface uppercase tracking-wide large">{node.displayName}</span>
										</span>
										<svg aria-hidden="true" class="caret text-on-surface-variant transition-transform duration-200" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
											<path d="m14.83 11.29-4.24-4.24a1 1 0 1 0-1.42 1.41L12.71 12l-3.54 3.54a1 1 0 0 0 0 1.41 1 1 0 0 0 .71.29 1 1 0 0 0 .71-.29l4.24-4.24a1.002 1.002 0 0 0 0-1.42Z"></path>
										</svg>
									</summary>
									<ul class="list-none my-1 ml-3 pl-2 border-l border-outline flex flex-col gap-0.5 sub-level">
										{node.children?.map((child) => (
											<li class="list-none sub-li">
												{child.type === 'folder' ? (
													<details open class="block group-details">
														<summary class="flex items-center justify-between px-2.5 py-1 rounded-md cursor-pointer select-none hover:bg-surface-container-high transition-colors group-summary">
															<span class="group-label">
																<span class="text-xs font-semibold text-on-surface">{child.displayName}</span>
															</span>
															<svg aria-hidden="true" class="caret text-on-surface-variant transition-transform duration-200" width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
																<path d="m14.83 11.29-4.24-4.24a1 1 0 1 0-1.42 1.41L12.71 12l-3.54 3.54a1 1 0 0 0 0 1.41 1 1 0 0 0 .71.29 1 1 0 0 0 .71-.29l4.24-4.24a1.002 1.002 0 0 0 0-1.42Z"></path>
															</svg>
														</summary>
														<ul class="list-none my-1 ml-3 pl-2 border-l border-outline flex flex-col gap-0.5 sub-level">
															{child.children?.map((grandChild) => (
																<li class="list-none sub-li">
																	<a 
																		href={`/docs/${grandChild.slug}`}
																		class="doc-link-btn block w-full text-left bg-transparent border-none px-2.5 py-1 text-xs font-medium text-on-surface-variant rounded cursor-pointer hover:bg-surface-container-high hover:text-on-surface transition-all no-underline"
																		data-id={grandChild.id}
																		data-slug={grandChild.slug}
																		data-title={grandChild.displayName.toLowerCase()}
																	>
																		<span>{grandChild.displayName}</span>
																	</a>
																</li>
															))}
														</ul>
													</details>
												) : (
													<a 
														href={`/docs/${child.slug}`}
														class="doc-link-btn block w-full text-left bg-transparent border-none px-2.5 py-1.5 text-xs font-medium text-on-surface-variant rounded cursor-pointer hover:bg-surface-container-high hover:text-on-surface transition-all no-underline"
														data-id={child.id}
														data-slug={child.slug}
														data-title={child.displayName.toLowerCase()}
													>
														<span>{child.displayName}</span>
													</a>
												)}
											</li>
										))}
									</ul>
								</details>
							) : (
								<a 
									href={`/docs/${node.slug}`}
									class="doc-link-btn block w-full text-left bg-transparent border-none px-2.5 py-1.5 text-xs font-medium text-on-surface-variant rounded cursor-pointer hover:bg-surface-container-high hover:text-on-surface transition-all no-underline"
									data-id={node.id}
									data-slug={node.slug}
									data-title={node.displayName.toLowerCase()}
								>
									<span>{node.displayName}</span>
								</a>
							)}
						</li>
					))}
				</ul>
			</nav>

			<div class="pt-3 border-t border-outline">
				<div class="flex items-center gap-2 text-xs text-on-surface-variant">
					<span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
					<span>astro-icon Active</span>
				</div>
			</div>
		</aside>

		<!-- Left Pane: Mode Switcher (CodeMirror Source vs Rendered Markdown Document) -->
		<div class="flex flex-col h-full overflow-hidden border-r border-outline-variant bg-white">
			<div class="h-10 bg-surface-container-low border-b border-outline-variant flex items-center justify-between px-4 flex-shrink-0">
				<div class="flex items-center gap-2">
					<span class="text-xs">📝</span>
					<span class="font-semibold text-xs text-on-surface">Document Editor</span>
				</div>
				<!-- View Mode Toggle -->
				<div class="flex items-center bg-surface-container-high rounded-lg p-0.5 border border-outline">
					<button id="view-mode-editor" class="text-[11px] font-semibold px-2.5 py-0.5 rounded-md bg-white text-primary shadow-xs cursor-pointer transition-all">Edit Source</button>
					<button id="view-mode-rendered" class="text-[11px] font-semibold px-2.5 py-0.5 rounded-md text-on-surface-variant hover:text-on-surface cursor-pointer transition-all">Rendered Doc</button>
				</div>
			</div>
			
			<!-- CodeMirror Source Editor Container -->
			<div id="codemirror-wrapper-pane" class="flex-1 overflow-hidden font-mono text-xs"></div>
			
			<!-- Final Formatted Rendered Markdown View -->
			<div id="rendered-doc-view-pane" class="hidden flex-1 p-6 overflow-y-auto font-body text-sm leading-relaxed text-on-surface markdown-render-body"></div>
		</div>

		<!-- Right Pane: Code Outputs & Inspector Only -->
		<div class="flex flex-col h-full overflow-hidden bg-surface-container">
			<div class="h-10 bg-surface-container-low border-b border-outline-variant flex items-center justify-between px-4 flex-shrink-0">
				<div class="flex items-center gap-1.5">
					<span class="text-xs">⚡</span>
					<span class="font-semibold text-xs text-on-surface">Code Output Inspector</span>
				</div>
				<span class="text-[11px] text-on-surface-variant" id="current-doc-title">{initialTitle || "Minimatic Workbench"}</span>
			</div>

			<div id="inspector-output-pane" class="flex-1 p-6 overflow-y-auto space-y-6">
				<!-- Output blocks dynamically rendered here -->
			</div>
		</div>
	</div>
</div>

<script define:vars={{ propSlug: initialSlug, propContent: initialContent, propTitle: initialTitle, propPath: initialPath }}>
	window.__INITIAL_DOC__ = {
		slug: propSlug,
		content: propContent,
		title: propTitle,
		path: propPath
	};
</script>

<script>
import { EditorView, basicSetup } from 'codemirror';
import { EditorState } from '@codemirror/state';
import { markdown } from '@codemirror/lang-markdown';
import { marked } from 'marked';
import { renderMMT } from '../utils/mmt-engine.js';
import { renderMinimatic } from '../utils/minimatic-engine.js';
import { runPythonCode } from '../utils/python-engine.js';

// Read src/content/**/*.md directly in client script
const contentFiles = import.meta.glob('../content/**/*.md', { query: '?raw', eager: true, import: 'default' });

function formatName(name: string) {
  return name
    .replace(/\.md$/, '')
    .split(/[-_]/)
    .map(w => w.charAt(0).toUpperCase() + w.slice(1))
    .join(' ');
}

const DOC_PRESETS = Object.entries(contentFiles).map(([filePath, content]) => {
  const relative = filePath.replace(/^.*\/content\//, '');
  const parts = relative.split('/');
  const fileName = parts.pop() || '';
  const id = relative.replace(/\.md$/, '').replace(/[\/\s]+/g, '-');
  const slug = relative.replace(/\.md$/, '').toLowerCase().replace(/[\/\s]+/g, '/');
  const title = formatName(fileName);

  return {
    id,
    slug,
    title,
    path: relative,
    content: content as string
  };
});

// Determine initial active slug from window.__INITIAL_DOC__ or URL or props
let activeSlug = '';
const initialProps = (window as any).__INITIAL_DOC__ || {};

if (initialProps.slug) {
	activeSlug = initialProps.slug;
} else {
	const pathname = window.location.pathname.replace(/\/$/, '');
	if (pathname.startsWith('/docs/') && pathname.length > 6) {
		activeSlug = pathname.replace('/docs/', '');
	} else {
		activeSlug = DOC_PRESETS[0]?.slug || '';
	}
}

let docContentMap = {};

DOC_PRESETS.forEach(doc => {
	const saved = localStorage.getItem('doc_content_' + doc.id);
	docContentMap[doc.id] = saved || doc.content;
});

const cmWrapperPane = document.getElementById('codemirror-wrapper-pane') as HTMLDivElement;
const renderedDocPane = document.getElementById('rendered-doc-view-pane') as HTMLDivElement;
const inspectorPane = document.getElementById('inspector-output-pane') as HTMLDivElement;
const currentTitleEl = document.getElementById('current-doc-title') as HTMLSpanElement;
const searchInput = document.getElementById('doc-search-input') as HTMLInputElement;

const btnViewEditor = document.getElementById('view-mode-editor');
const btnViewRendered = document.getElementById('view-mode-rendered');

let currentViewMode = 'editor';
let cmEditor: EditorView | null = null;
let currentDocId = '';

function initCodeMirror(initialDoc: string) {
	if (!cmWrapperPane) return;
	if (cmEditor) cmEditor.destroy();

	const updateListener = EditorView.updateListener.of((update) => {
		if (update.docChanged && currentDocId) {
			const currentText = update.state.doc.toString();
			docContentMap[currentDocId] = currentText;
			localStorage.setItem('doc_content_' + currentDocId, currentText);
			updateRenderedDocView(currentText);
			evaluateCodeOutputs(currentText);
		}
	});

	const customTheme = EditorView.theme({
		"&": { height: "100%", fontSize: "13px" },
		".cm-scroller": { overflow: "auto", fontFamily: "'Fira Code', monospace" },
		".cm-content": { padding: "16px 20px" },
		".cm-gutters": { backgroundColor: "#f7f2eb", borderRight: "1px solid #c7c4c2", color: "#95908d" },
		".cm-activeLine": { backgroundColor: "rgba(23, 128, 94, 0.05)" },
		".cm-activeLineGutter": { backgroundColor: "#e9ded8", color: "#17805e" }
	});

	const state = EditorState.create({
		doc: initialDoc,
		extensions: [
			basicSetup,
			markdown(),
			updateListener,
			customTheme,
			EditorView.lineWrapping
		]
	});

	cmEditor = new EditorView({
		state,
		parent: cmWrapperPane
	});
}

function updateRenderedDocView(markdownText: string) {
	if (renderedDocPane) {
		renderedDocPane.innerHTML = marked.parse(markdownText) as string;
	}
}

function setViewMode(mode: string) {
	currentViewMode = mode;
	if (mode === 'editor') {
		cmWrapperPane?.classList.remove('hidden');
		renderedDocPane?.classList.add('hidden');

		btnViewEditor?.classList.add('bg-white', 'text-primary', 'shadow-xs');
		btnViewEditor?.classList.remove('text-on-surface-variant');

		btnViewRendered?.classList.remove('bg-white', 'text-primary', 'shadow-xs');
		btnViewRendered?.classList.add('text-on-surface-variant');
	} else {
		cmWrapperPane?.classList.add('hidden');
		renderedDocPane?.classList.remove('hidden');

		btnViewRendered?.classList.add('bg-white', 'text-primary', 'shadow-xs');
		btnViewRendered?.classList.remove('text-on-surface-variant');

		btnViewEditor?.classList.remove('bg-white', 'text-primary', 'shadow-xs');
		btnViewEditor?.classList.add('text-on-surface-variant');
	}
}

btnViewEditor?.addEventListener('click', () => setViewMode('editor'));
btnViewRendered?.addEventListener('click', () => setViewMode('rendered'));

function loadDocumentBySlug(slug: string, pushState = false) {
	activeSlug = slug;
	const doc = DOC_PRESETS.find(d => d.slug === slug || d.id === slug) || DOC_PRESETS[0];
	if (!doc) return;

	currentDocId = doc.id;
	if (currentTitleEl) currentTitleEl.innerText = doc.title;

	if (pushState) {
		const newUrl = '/docs/' + doc.slug;
		window.history.pushState({ slug: doc.slug }, '', newUrl);
	}
	
	const content = docContentMap[doc.id] || doc.content;
	initCodeMirror(content);
	updateRenderedDocView(content);

	document.querySelectorAll('.doc-link-btn').forEach(el => {
		if (el.getAttribute('data-slug') === doc.slug || el.getAttribute('data-id') === doc.id) {
			el.classList.add('!bg-primary-container', '!text-primary', '!font-semibold');
		} else {
			el.classList.remove('!bg-primary-container', '!text-primary', '!font-semibold');
		}
	});

	evaluateCodeOutputs(content);
}

function evaluateCodeOutputs(markdownText: string) {
	if (!inspectorPane) return;

	inspectorPane.innerHTML = '';
	let foundCodeBlocks = 0;

	// Regex search for ```lang ... ``` blocks
	const codeBlockRegex = /```(\w+)?\n([\s\S]*?)```/g;
	let match;

	while ((match = codeBlockRegex.exec(markdownText)) !== null) {
		const lang = (match[1] || '').toLowerCase().trim();
		const codeText = match[2].trim();
		const index = foundCodeBlocks + 1;

		if (lang === 'mmt' || codeText.includes('node:') || codeText.includes('table:')) {
			foundCodeBlocks++;
			const mmtHtml = renderMMT(codeText);
			const card = document.createElement('div');
			card.className = 'bg-white border border-outline rounded-xl p-4 shadow-sm';
			card.innerHTML = `
				<div class="flex items-center justify-between mb-3 border-b border-outline-variant pb-2">
					<span class="font-bold text-xs text-primary">📐 MMT Diagram & Table Output</span>
					<span class="text-[10px] font-mono bg-surface-container-high px-2 py-0.5 rounded text-on-surface-variant">Block #${index}</span>
				</div>
				${mmtHtml}
			`;
			inspectorPane.appendChild(card);
		} else if (lang === 'minimatic' || codeText.includes('state') || codeText.includes('button')) {
			foundCodeBlocks++;
			const miniHtml = renderMinimatic(codeText);
			const card = document.createElement('div');
			card.className = 'bg-white border border-outline rounded-xl p-4 shadow-sm';
			card.innerHTML = `
				<div class="flex items-center justify-between mb-3 border-b border-outline-variant pb-2">
					<span class="font-bold text-xs text-primary">⚡ Minimatic State Analyzer Output</span>
					<span class="text-[10px] font-mono bg-surface-container-high px-2 py-0.5 rounded text-on-surface-variant">Block #${index}</span>
				</div>
				${miniHtml}
			`;
			inspectorPane.appendChild(card);
		} else if (lang === 'python' || codeText.includes('def ') || codeText.includes('print(')) {
			foundCodeBlocks++;
			const outputId = 'py_inspector_out_' + index;
			const card = document.createElement('div');
			card.className = 'bg-white border border-outline rounded-xl p-4 shadow-sm';
			card.innerHTML = `
				<div class="flex items-center justify-between mb-3 border-b border-outline-variant pb-2">
					<span class="font-bold text-xs text-primary">🐍 Python Code Output Console</span>
					<button class="run-py-btn bg-primary text-on-primary border-none text-[11px] font-semibold px-3 py-1 rounded-full cursor-pointer hover:bg-primary-hover transition-colors">Run Code</button>
				</div>
				<pre class="bg-surface-container-low p-3 rounded-lg text-xs font-mono mb-3 overflow-x-auto"><code>${codeText}</code></pre>
				<div id="${outputId}" class="py-output"></div>
			`;
			inspectorPane.appendChild(card);

			const btn = card.querySelector('.run-py-btn');
			if (btn) {
				btn.addEventListener('click', () => runPythonCode(codeText, outputId));
			}
			runPythonCode(codeText, outputId);
		}
	}

	if (foundCodeBlocks === 0) {
		inspectorPane.innerHTML = `
			<div class="bg-white border border-outline rounded-xl p-8 text-center text-on-surface-variant">
				<div class="text-3xl mb-2">🔍</div>
				<div class="font-bold text-sm text-on-surface mb-1">No Code Executables Found</div>
				<div class="text-xs">Add a <code>\`\`\`python</code>, <code>\`\`\`mmt</code>, or <code>\`\`\`minimatic</code> block in the CodeMirror editor to see live visual output.</div>
			</div>
		`;
	}
}

// Handle popstate for browser Back/Forward navigation
window.addEventListener('popstate', (e) => {
	const currentPath = window.location.pathname.replace(/\/$/, '');
	if (currentPath.startsWith('/docs/') && currentPath.length > 6) {
		const slug = currentPath.replace('/docs/', '');
		loadDocumentBySlug(slug, false);
	}
});

// Sidebar link click handling
document.querySelectorAll('.doc-link-btn').forEach(btn => {
	btn.addEventListener('click', (e) => {
		e.preventDefault();
		const target = e.currentTarget as HTMLElement;
		const slug = target.getAttribute('data-slug');
		if (slug) loadDocumentBySlug(slug, true);
	});
});

// Search Filter
searchInput?.addEventListener('input', (e) => {
	const query = (e.target as HTMLInputElement).value.toLowerCase();
	let visibleCount = 0;

	document.querySelectorAll('.doc-link-btn').forEach(btn => {
		const el = btn as HTMLElement;
		const title = el.getAttribute('data-title') || '';
		if (title.includes(query)) {
			(el.closest('.sub-li') as HTMLElement).style.display = 'block';
			visibleCount++;
		} else {
			(el.closest('.sub-li') as HTMLElement).style.display = 'none';
		}
	});

	const badge = document.getElementById('doc-count-badge');
	if (badge) badge.innerText = String(visibleCount);
});

// Keyboard '/' shortcut
window.addEventListener('keydown', (e) => {
	if (e.key === '/' && document.activeElement !== searchInput) {
		e.preventDefault();
		searchInput?.focus();
	}
});

document.getElementById('btn-reset')?.addEventListener('click', () => {
	const doc = DOC_PRESETS.find(d => d.slug === activeSlug || d.id === currentDocId);
	if (doc && cmEditor) {
		docContentMap[doc.id] = doc.content;
		localStorage.removeItem('doc_content_' + doc.id);
		cmEditor.dispatch({
			changes: { from: 0, to: cmEditor.state.doc.length, insert: doc.content }
		});
		updateRenderedDocView(doc.content);
		evaluateCodeOutputs(doc.content);
	}
});

document.getElementById('btn-copy')?.addEventListener('click', () => {
	if (cmEditor) {
		const text = cmEditor.state.doc.toString();
		navigator.clipboard.writeText(text);
		const btn = document.getElementById('btn-copy');
		if (btn) {
			btn.innerText = 'Copied!';
			setTimeout(() => btn.innerText = 'Copy MD', 2000);
		}
	}
});

// Initial load
if (activeSlug) loadDocumentBySlug(activeSlug, false);
</script>

