---
// Read src/content/*.md directly using relative path from src/components/
const contentFiles = import.meta.glob('../content/*.md', { query: '?raw', eager: true, import: 'default' });

function formatTitle(filename: string) {
  const name = filename.split('/').pop()?.replace(/\.md$/, '') || filename;
  return name
    .split(/[-_]/)
    .map(word => word.charAt(0).toUpperCase() + word.slice(1))
    .join(' ');
}

function getCategory(filename: string) {
  if (filename.includes('proposal')) return 'Proposals';
  if (filename.includes('learn') || filename.includes('roadmap')) return 'Guides';
  return 'Core Spec';
}

const DOC_PRESETS = Object.entries(contentFiles).map(([path, content]) => {
  const id = path.split('/').pop()?.replace(/\.md$/, '').replace(/\s+/g, '-') || path;
  return {
    id,
    title: formatTitle(path),
    category: getCategory(path),
    content: content as string
  };
});

// Group presets by category
const categories = Array.from(new Set(DOC_PRESETS.map(d => d.category)));
const groupedDocs = categories.map(cat => ({
	category: cat,
	docs: DOC_PRESETS.filter(d => d.category === cat)
}));
---

<div class="flex flex-col h-screen w-screen overflow-hidden bg-surface">
	<!-- Navbar (Astro Docs Style: withastro/docs) -->
	<header class="h-15 bg-surface border-b border-outline-variant flex items-center justify-between px-5 gap-4">
		<div class="flex items-center gap-2.5 min-w-[200px]">
			<a href="/" class="flex items-center gap-2 no-underline text-on-surface">
				<svg width="24" height="24" viewBox="0 0 24 24" fill="none">
					<path d="M12 2L2 22H6L12 10L18 22H22L12 2Z" fill="#17805e"/>
					<circle cx="12" cy="15" r="2.5" fill="#a8d5c4"/>
				</svg>
				<span class="font-display font-bold text-lg">Minimatic</span>
				<span class="font-medium text-sm text-primary">Docs</span>
			</a>
			<span class="bg-surface-container-high text-on-surface-variant text-[11px] font-semibold px-2 py-0.5 rounded-full border border-outline">v0.1</span>
		</div>

		<!-- Search Input (Astro Docs style) -->
		<div class="relative flex-1 max-w-[420px] flex items-center">
			<svg class="absolute left-3 text-on-surface-variant" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
				<circle cx="11" cy="11" r="8"></circle>
				<line x1="21" y1="21" x2="16.65" y2="16.65"></line>
			</svg>
			<input type="text" id="doc-search-input" placeholder="Search documentation... (Press '/')" class="w-full h-9.5 pl-9 pr-3.5 bg-surface-container-low border border-outline rounded-full text-xs text-on-surface outline-none focus:border-primary focus:ring-2 focus:ring-primary/10 focus:bg-white transition-all" />
		</div>

		<!-- Nav Links -->
		<nav class="flex items-center gap-2">
			<button class="nav-link-btn active bg-primary-container text-primary font-semibold text-xs px-3 py-1.5 rounded-full cursor-pointer hover:bg-primary-container/80 transition-colors" data-filter="all">All</button>
			<button class="nav-link-btn text-on-surface-variant font-semibold text-xs px-3 py-1.5 rounded-full cursor-pointer hover:bg-surface-container-high hover:text-on-surface transition-colors" data-filter="Core Spec">Core Spec</button>
			<button class="nav-link-btn text-on-surface-variant font-semibold text-xs px-3 py-1.5 rounded-full cursor-pointer hover:bg-surface-container-high hover:text-on-surface transition-colors" data-filter="Guides">Guides</button>
			<button class="nav-link-btn text-on-surface-variant font-semibold text-xs px-3 py-1.5 rounded-full cursor-pointer hover:bg-surface-container-high hover:text-on-surface transition-colors" data-filter="Proposals">Proposals</button>
			<a href="https://github.com/gabrielebaez/minimatic-kernel" target="_blank" rel="noopener" class="text-on-surface-variant hover:text-primary p-1.5 rounded-full transition-colors" title="GitHub Repository">
				<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
					<path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
				</svg>
			</a>
			<button id="btn-reset" class="bg-transparent text-on-surface border border-outline rounded-full px-3.5 py-1.5 font-semibold text-xs cursor-pointer hover:bg-surface-container-high transition-colors">Reset</button>
			<button id="btn-copy" class="bg-primary text-on-primary border-none rounded-full px-4 py-1.5 font-semibold text-xs cursor-pointer hover:bg-primary-hover shadow-sm transition-colors">Copy MD</button>
		</nav>
	</header>

	<!-- Main Fourfold Workspace -->
	<div class="grid grid-cols-[280px_1fr_1fr] h-[calc(100vh-60px)] overflow-hidden">
		<!-- Sidebar Nav (Astro Docs Starlight Collapsible Details/Summary Tree) -->
		<aside class="bg-surface-container-low border-r border-outline-variant flex flex-col p-4 overflow-hidden">
			<div class="flex items-center justify-between mb-3 px-2">
				<span class="text-[11px] font-bold tracking-wider text-on-surface-variant">DOCUMENTATION</span>
				<span id="doc-count-badge" class="bg-surface-container-highest text-on-surface text-[10px] font-bold px-1.5 py-0.5 rounded">{DOC_PRESETS.length}</span>
			</div>
			
			<nav class="flex-1 overflow-y-auto pr-1">
				<ul class="flex flex-col gap-1.5 list-none m-0 p-0">
					{groupedDocs.map((group) => (
						<li class="list-none group-li" data-category-group={group.category}>
							<details open class="block group-details">
								<summary class="flex items-center justify-between px-2.5 py-1.5 rounded-md cursor-pointer select-none hover:bg-surface-container-high transition-colors group-summary">
									<span class="group-label">
										<span class="text-xs font-bold text-on-surface uppercase tracking-wide large">{group.category}</span>
									</span>
									<svg aria-hidden="true" class="caret text-on-surface-variant transition-transform duration-200" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
										<path d="m14.83 11.29-4.24-4.24a1 1 0 1 0-1.42 1.41L12.71 12l-3.54 3.54a1 1 0 0 0 0 1.41 1 1 0 0 0 .71.29 1 1 0 0 0 .71-.29l4.24-4.24a1.002 1.002 0 0 0 0-1.42Z"></path>
									</svg>
								</summary>
								<ul class="list-none my-1 ml-3 pl-2 border-l border-outline flex flex-col gap-0.5 sub-level">
									{group.docs.map((preset) => (
										<li class="list-none sub-li">
											<button 
												class="doc-link-btn w-full text-left bg-transparent border-none px-2.5 py-1.5 text-xs font-medium text-on-surface-variant rounded cursor-pointer hover:bg-surface-container-high hover:text-on-surface transition-all"
												data-id={preset.id}
												data-category={preset.category}
												data-title={preset.title.toLowerCase()}
											>
												<span>{preset.title}</span>
											</button>
										</li>
									))}
								</ul>
							</details>
						</li>
					))}
				</ul>
			</nav>

			<div class="pt-3 border-t border-outline">
				<div class="flex items-center gap-2 text-xs text-on-surface-variant">
					<span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
					<span>Eve Analyzer Engine Active</span>
				</div>
			</div>
		</aside>

		<!-- Editor Pane (Center/Left) -->
		<div class="flex flex-col h-full overflow-hidden border-r border-outline-variant bg-white">
			<div class="h-10 bg-surface-container-low border-b border-outline-variant flex items-center justify-between px-4">
				<div class="flex items-center gap-1.5">
					<span class="text-xs">📝</span>
					<span class="font-semibold text-xs text-on-surface">Markdown Memory Editor</span>
				</div>
				<span class="text-[11px] text-on-surface-variant">Live Keyup Evaluation</span>
			</div>
			<textarea id="markdown-input" spellcheck="false" placeholder="Type Markdown here..." class="flex-1 w-full p-5 border-none outline-none resize-none font-mono text-xs leading-relaxed text-on-surface bg-white"></textarea>
		</div>

		<!-- Preview Pane (Right) -->
		<div class="flex flex-col h-full overflow-hidden bg-surface-container">
			<div class="h-10 bg-surface-container-low border-b border-outline-variant flex items-center justify-between px-4">
				<div class="flex items-center gap-1.5">
					<span class="text-xs">🔍</span>
					<span class="font-semibold text-xs text-on-surface">Eve Inspector & Live Render</span>
				</div>
				<span class="text-[11px] text-on-surface-variant" id="current-doc-title">Minimatic Workbench</span>
			</div>
			<div id="preview-output" class="flex-1 p-6 overflow-y-auto font-body text-sm leading-relaxed text-on-surface"></div>
		</div>
	</div>
</div>

<script>
import { marked } from 'marked';
import { renderMMT } from '../utils/mmt-engine.js';
import { renderMinimatic } from '../utils/minimatic-engine.js';
import { runPythonCode } from '../utils/python-engine.js';

// Read src/content/*.md directly in client script
const contentFiles = import.meta.glob('../content/*.md', { query: '?raw', eager: true, import: 'default' });

function formatTitle(filename: string) {
  const name = filename.split('/').pop()?.replace(/\.md$/, '') || filename;
  return name
    .split(/[-_]/)
    .map(word => word.charAt(0).toUpperCase() + word.slice(1))
    .join(' ');
}

function getCategory(filename: string) {
  if (filename.includes('proposal')) return 'Proposals';
  if (filename.includes('learn') || filename.includes('roadmap')) return 'Guides';
  return 'Core Spec';
}

const DOC_PRESETS = Object.entries(contentFiles).map(([path, content]) => {
  const id = path.split('/').pop()?.replace(/\.md$/, '').replace(/\s+/g, '-') || path;
  return {
    id,
    title: formatTitle(path),
    category: getCategory(path),
    content: content as string
  };
});

let activeDocId = DOC_PRESETS[0]?.id || '';
let docContentMap = {};

DOC_PRESETS.forEach(doc => {
	const saved = localStorage.getItem('doc_content_' + doc.id);
	docContentMap[doc.id] = saved || doc.content;
});

const editorInput = document.getElementById('markdown-input') as HTMLTextAreaElement;
const previewOutput = document.getElementById('preview-output') as HTMLDivElement;
const currentTitleEl = document.getElementById('current-doc-title') as HTMLSpanElement;
const searchInput = document.getElementById('doc-search-input') as HTMLInputElement;

function loadDocument(id: string) {
	activeDocId = id;
	const doc = DOC_PRESETS.find(d => d.id === id) || DOC_PRESETS[0];
	if (currentTitleEl && doc) currentTitleEl.innerText = doc.title;
	if (doc) editorInput.value = docContentMap[id];

	document.querySelectorAll('.doc-link-btn').forEach(el => {
		if (el.getAttribute('data-id') === id) {
			el.classList.add('!bg-primary-container', '!text-primary', '!font-semibold');
		} else {
			el.classList.remove('!bg-primary-container', '!text-primary', '!font-semibold');
		}
	});

	updatePreview();
}

async function updatePreview() {
	const text = editorInput.value;
	docContentMap[activeDocId] = text;
	localStorage.setItem('doc_content_' + activeDocId, text);

	let html = marked.parse(text) as string;
	const tempDiv = document.createElement('div');
	tempDiv.innerHTML = html;

	const pythonBlocksToRun = [];

	tempDiv.querySelectorAll('pre code').forEach((codeEl, index) => {
		const langClass = codeEl.className || '';
		const codeText = codeEl.textContent || '';
		const preParent = codeEl.parentElement;

		if (langClass.includes('language-mmt')) {
			const mmtHtml = renderMMT(codeText);
			const wrapper = document.createElement('div');
			wrapper.innerHTML = mmtHtml;
			preParent?.replaceWith(wrapper);
		} else if (langClass.includes('language-minimatic')) {
			const miniHtml = renderMinimatic(codeText);
			const wrapper = document.createElement('div');
			wrapper.innerHTML = miniHtml;
			preParent?.replaceWith(wrapper);
		} else if (langClass.includes('language-python')) {
			const outputId = 'py_out_' + Math.random().toString(36).substr(2, 6);
			const wrapper = document.createElement('div');
			wrapper.style.margin = '16px 0';
			wrapper.style.border = '1px solid var(--outline)';
			wrapper.style.borderRadius = '12px';
			wrapper.style.padding = '16px';
			wrapper.style.background = '#ffffff';

			wrapper.innerHTML = `
				<div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px;">
					<span style="font-weight: 600; font-size: 13px; color: #17805e;">🐍 Python Evaluator</span>
					<button class="run-py-btn" style="background: #17805e; color: #ffffff; border: none; padding: 4px 12px; border-radius: 9999px; font-size: 12px; cursor: pointer; font-weight: 600;">Run Code</button>
				</div>
				<pre style="background: #f7f2eb; padding: 10px; border-radius: 8px; font-size: 13px; margin-bottom: 10px;"><code>${codeText}</code></pre>
				<div id="${outputId}" class="py-output"></div>
			`;

			preParent?.replaceWith(wrapper);
			pythonBlocksToRun.push({ codeText, outputId, btn: wrapper.querySelector('.run-py-btn') });
		}
	});

	previewOutput.innerHTML = tempDiv.innerHTML;

	pythonBlocksToRun.forEach(item => {
		if (item.btn) {
			item.btn.addEventListener('click', () => {
				runPythonCode(item.codeText, item.outputId);
			});
		}
		runPythonCode(item.codeText, item.outputId);
	});
}

// Search Filter & Nav category filter
searchInput?.addEventListener('input', (e) => {
	const query = (e.target as HTMLInputElement).value.toLowerCase();
	filterDocs(query, activeCategoryFilter);
});

let activeCategoryFilter = 'all';

document.querySelectorAll('.nav-link-btn').forEach(btn => {
	btn.addEventListener('click', (e) => {
		const target = e.currentTarget as HTMLElement;
		const filter = target.getAttribute('data-filter') || 'all';
		activeCategoryFilter = filter;

		document.querySelectorAll('.nav-link-btn').forEach(b => {
			b.classList.remove('bg-primary-container', 'text-primary');
			b.classList.add('text-on-surface-variant');
		});
		target.classList.add('bg-primary-container', 'text-primary');
		target.classList.remove('text-on-surface-variant');

		filterDocs(searchInput?.value.toLowerCase() || '', filter);
	});
});

function filterDocs(searchQuery: string, categoryFilter: string) {
	let visibleCount = 0;

	document.querySelectorAll('.group-li').forEach(groupEl => {
		const grpCategory = groupEl.getAttribute('data-category-group') || '';
		const matchesCategory = categoryFilter === 'all' || grpCategory === categoryFilter;

		let groupHasVisibleChild = false;
		groupEl.querySelectorAll('.doc-link-btn').forEach(btn => {
			const el = btn as HTMLElement;
			const title = el.getAttribute('data-title') || '';

			const matchesSearch = title.includes(searchQuery);

			if (matchesSearch && matchesCategory) {
				(el.closest('.sub-li') as HTMLElement).style.display = 'block';
				groupHasVisibleChild = true;
				visibleCount++;
			} else {
				(el.closest('.sub-li') as HTMLElement).style.display = 'none';
			}
		});

		if (groupHasVisibleChild) {
			(groupEl as HTMLElement).style.display = 'block';
			const details = groupEl.querySelector('details');
			if (details) details.open = true;
		} else {
			(groupEl as HTMLElement).style.display = 'none';
		}
	});

	const badge = document.getElementById('doc-count-badge');
	if (badge) badge.innerText = String(visibleCount);
}

// Keyboard '/' shortcut
window.addEventListener('keydown', (e) => {
	if (e.key === '/' && document.activeElement !== editorInput && document.activeElement !== searchInput) {
		e.preventDefault();
		searchInput?.focus();
	}
});

editorInput.addEventListener('input', () => {
	updatePreview();
});

document.querySelectorAll('.doc-link-btn').forEach(btn => {
	btn.addEventListener('click', (e) => {
		const target = e.currentTarget as HTMLElement;
		const id = target.getAttribute('data-id');
		if (id) loadDocument(id);
	});
});

document.getElementById('btn-reset')?.addEventListener('click', () => {
	const doc = DOC_PRESETS.find(d => d.id === activeDocId);
	if (doc) {
		docContentMap[activeDocId] = doc.content;
		localStorage.removeItem('doc_content_' + activeDocId);
		editorInput.value = doc.content;
		updatePreview();
	}
});

document.getElementById('btn-copy')?.addEventListener('click', () => {
	navigator.clipboard.writeText(editorInput.value);
	const btn = document.getElementById('btn-copy');
	if (btn) {
		btn.innerText = 'Copied!';
		setTimeout(() => btn.innerText = 'Copy MD', 2000);
	}
});

// Initial load
if (activeDocId) loadDocument(activeDocId);
</script>

<style>
details[open] > summary .caret {
	transform: rotate(90deg);
}

#preview-output h1 {
	font-size: 1.625rem;
	margin-top: 0;
	color: #17805e;
	border-bottom: 2px solid #a8d5c4;
	padding-bottom: 0.5rem;
}

#preview-output h2 {
	font-size: 1.125rem;
	margin-top: 1.25rem;
}

#preview-output code {
	background: #e9ded8;
	padding: 0.125rem 0.375rem;
	border-radius: 0.25rem;
	font-size: 0.8125rem;
	color: #17805e;
}

#preview-output pre {
	background: #e9ded8;
	padding: 0.875rem;
	border-radius: 0.5rem;
	overflow-x: auto;
}

#preview-output pre code {
	background: transparent;
	padding: 0;
	color: inherit;
}
</style>
